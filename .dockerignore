# Allow only inputs used by the API, migration, and web Dockerfiles.
# Git history, local deployments, docs, personal files, and tests stay out.
**
!package.json
!package-lock.json
!apps/
apps/**
!apps/api/
apps/api/**
!apps/api/package.json
!apps/api/tsconfig.json
!apps/api/prisma.config.ts
!apps/api/prisma/
!apps/api/prisma/**
!apps/api/src/
!apps/api/src/**
!apps/web/
apps/web/**
!apps/web/package.json
!apps/web/angular.json
!apps/web/tsconfig.json
!apps/web/tsconfig.app.json
!apps/web/.postcssrc.json
!apps/web/nginx.conf
!apps/web/src/
!apps/web/src/**
!apps/web/public/
!apps/web/public/**

# Protect sensitive/local files even inside an allowed source directory.
**/node_modules
**/dist
**/generated
**/.angular
**/.env
**/.env.*
**/.envrc
**/.npmrc
**/.yarnrc.yml
**/.git
**/.ssh
**/.aws
**/.azure
**/.kube
**/.vscode
**/.idea
**/.codex
**/.claude
**/private
**/personal
**/secrets.*
**/secret.yaml
**/secret.yml
**/credentials.json
**/service-account*.json
**/kubeconfig*
**/id_rsa*
**/id_ed25519*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.log
**/*.dump
**/*.backup
**/*.bak
**/*.sql.gz
**/*.sql.zip
**/*.sqlite
**/*.sqlite3
**/*.db
**/.DS_Store
**/Thumbs.db
