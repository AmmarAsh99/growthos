generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(254)
  displayName String @db.VarChar(80)
  passwordHash String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  settings UserSettings?
  categories Category[]
  activities Activity[]
  sessions RefreshSession[]
  financeSettings FinanceSettings?
  financeMonths FinanceMonth[]
  financeCategories FinanceCategory[]
  transactions FinanceTransaction[]
  @@map("users")
}
model FinanceSettings {
  userId String @id @db.Uuid
  currency String @default("SAR")
  timezone String @default("Asia/Riyadh")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("finance_settings")
}
model FinanceMonth {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  month String @db.VarChar(7)
  salaryHalalas Int
  warningPercent Int @default(80)
  categoryRules Json
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  envelopes FinanceEnvelope[]
  @@unique([userId, month])
  @@unique([id, userId])
  @@map("finance_months")
}
model FinanceEnvelope {
  id String @id @default(uuid()) @db.Uuid
  monthId String @db.Uuid
  userId String @db.Uuid
  key String @db.VarChar(40)
  name String @db.VarChar(60)
  kind String @db.VarChar(20)
  discretionary Boolean @default(false)
  amountHalalas Int
  month FinanceMonth @relation(fields: [monthId, userId], references: [id, userId], onDelete: Cascade)
  transactions FinanceTransaction[]
  @@unique([monthId, key])
  @@unique([id, userId])
  @@map("finance_envelopes")
}
model FinanceCategory {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  name String @db.VarChar(60)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]
  @@unique([userId, name])
  @@unique([id, userId])
  @@map("finance_categories")
}
model FinanceTransaction {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  categoryId String? @db.Uuid
  envelopeId String? @db.Uuid
  kind String @db.VarChar(20)
  amountHalalas Int
  date DateTime @db.Date
  time String? @db.VarChar(5)
  description String @db.VarChar(160)
  notes String? @db.VarChar(2000)
  merchant String? @db.VarChar(100)
  frequency String? @db.VarChar(20)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  category FinanceCategory? @relation(fields: [categoryId, userId], references: [id, userId], onDelete: Restrict)
  envelope FinanceEnvelope? @relation(fields: [envelopeId, userId], references: [id, userId], onDelete: Restrict)
  @@index([userId, date(sort: Desc)])
  @@index([userId, envelopeId, date])
  @@map("finance_transactions")
}
model UserSettings {
  userId String @id @db.Uuid
  dailyGoalMinutes Int @default(120)
  timezone String @default("Asia/Riyadh") @db.VarChar(100)
  weekStart Int @default(1) @db.SmallInt
  updatedAt DateTime @updatedAt @db.Timestamptz
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("user_settings")
}
model Category {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  name String @db.VarChar(60)
  slug String @db.VarChar(80)
  color String @db.VarChar(7)
  icon String? @db.VarChar(40)
  isArchived Boolean @default(false)
  sortOrder Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]
  @@unique([userId, slug])
  @@unique([id, userId])
  @@map("categories")
}
model Activity {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  categoryId String @db.Uuid
  activityDate DateTime @db.Date
  title String @db.VarChar(120)
  description String?
  durationMinutes Int
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId, userId], references: [id, userId])
  @@index([userId, activityDate(sort: Desc)])
  @@index([userId, categoryId, activityDate(sort: Desc)])
  @@map("activities")
}
model RefreshSession {
  id String @id @db.Uuid
  userId String @db.Uuid
  refreshTokenHash String
  expiresAt DateTime @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("refresh_sessions")
}
